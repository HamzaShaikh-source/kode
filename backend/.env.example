# ── K.O.D.E. backend configuration. Copy to .env. Values are NEVER logged. ──

# GitHub: PAT with `repo` scope on the test repo below. REQUIRED for dispatch/PRs/merge.
GITHUB_TOKEN=
# Target repo as owner/name. It must already have a `main` commit. REQUIRED for dispatch.
GITHUB_REPO=
# Base branch that PRs target (merges happen here ONLY after human approval).
GITHUB_BASE_BRANCH=main

# LLM keys (LiteLLM). The key matching LLM_MODEL's provider is REQUIRED; missing => hard error.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# LiteLLM model id used by planner + all three agents.
LLM_MODEL=anthropic/claude-sonnet-5-5

# Human identities that own each agent's commits ("Name <email>"). REQUIRED for dispatch.
# Use the email attached to that person's GitHub account so commits are attributed to them.
AUTHOR_BACKEND=
AUTHOR_FRONTEND=
AUTHOR_QA=

# Local state
KODE_DB_PATH=./kode_state.db
KODE_CONTRACTS_DIR=./contracts
# Comma-separated CORS origins for the existing UI.
KODE_CORS_ORIGINS=http://localhost:5173

# Marks GitHub as simulated (no network; in-memory). Banner will say SIMULATED_GITHUB.
# Not implemented as a runtime mode today: leave false. Present so the banner is truthful.
SIMULATED_GITHUB=false
